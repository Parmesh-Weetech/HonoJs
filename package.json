{
  "name": "HonoJs",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typeorm": "tsx src/scripts/generate-migration.ts",
    "migration:generate": "tsx src/scripts/generate-migration.ts",
    "migration:run": "tsx node_modules/typeorm/cli-ts-node-esm.js -d src/config/database.ts migration:run",
    "migration:revert": "tsx node_modules/typeorm/cli-ts-node-esm.js -d src/config/database.ts migration:revert",
    "migration:show": "tsx node_modules/typeorm/cli-ts-node-esm.js -d src/config/database.ts migration:show"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.0",
    "@types/dotenv": "^8.2.3",
    "dotenv": "^17.4.2",
    "hono": "^4.13.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^5.5.4"
  }
}